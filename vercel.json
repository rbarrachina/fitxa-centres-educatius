{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "functions": {
    "api/centre.mjs": {
      "includeFiles": "web/**"
    }
  },
  "redirects": [
    {
      "source": "/centre/:centre",
      "destination": "/centre/:centre/",
      "statusCode": 301
    },
    {
      "source": "/centres",
      "destination": "/centres/",
      "statusCode": 301
    },
    {
      "source": "/municipis",
      "destination": "/municipis/",
      "statusCode": 301
    },
    {
      "source": "/centres/:area",
      "destination": "/centres/:area/",
      "statusCode": 301
    },
    {
      "source": "/centres/:area/:municipi",
      "destination": "/centres/:area/:municipi/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/centre/:centre/",
      "destination": "/api/centre"
    },
    {
      "source": "/centres/",
      "destination": "/api/directori"
    },
    {
      "source": "/municipis/",
      "destination": "/api/directori?view=municipis"
    },
    {
      "source": "/centres/:area/",
      "destination": "/api/directori"
    },
    {
      "source": "/centres/:area/:municipi/",
      "destination": "/api/directori"
    }
  ]
}
